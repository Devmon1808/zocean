<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionRooms"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background3"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-Add New Room-"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/inputRoomId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Room ID"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/inputRoomType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Room Type"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/inputRoomPrice"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Price"
        android:inputType="number"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/inputRoomStatus"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Status"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnAddRoom"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ADD ROOM"
        android:backgroundTint="@color/darkNavy"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-All Rooms-"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/roomListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/darkBlue"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ID: R01"
                        android:textSize="14sp"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available"
                        android:textSize="12sp"
                        android:textColor="#4CAF50"
                        android:background="#1B5E20"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type: OCEAN SINGLE"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price: ₱37,000"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="UPDATE"
                        android:textSize="12sp"
                        android:backgroundTint="@color/darkRed"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="DELETE"
                        android:textSize="12sp"
                        android:backgroundTint="@color/darkRed"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/darkBlue"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ID: R02"
                        android:textSize="14sp"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Occupied"
                        android:textSize="12sp"
                        android:textColor="#FF5252"
                        android:background="#B71C1C"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type: OCEAN DOUBLE"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price: ₱67,000"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="UPDATE"
                        android:textSize="12sp"
                        android:backgroundTint="@color/darkRed"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="4dp"/>

                    <Button
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="DELETE"
                        android:textSize="12sp"
                        android:backgroundTint="@color/darkRed"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>