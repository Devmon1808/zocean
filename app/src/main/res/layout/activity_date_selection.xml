<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background1"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/logoImageView"
        android:layout_width="100dp"
        android:layout_height="85dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/zhotel_logo_nobg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Your Stay"
        android:textColor="@color/softCream"
        android:textSize="16sp"
        android:alpha="0.8"
        android:layout_marginBottom="40dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#080918"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHECK-IN"
                android:textColor="@color/softCream"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/darkNavy"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/checkInDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Not selected"
                    android:textStyle="italic"
                    android:textColor="@color/softCream"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/selectCheckInButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SELECT DATE"
                android:backgroundTint="@color/darkNavy"
                android:textColor="@color/luxuryGold"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="32dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHECK-OUT"
                android:textColor="@color/softCream"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/darkNavy"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/checkOutDateText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Not selected"
                    android:textStyle="italic"
                    android:textColor="@color/softCream"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/selectCheckOutButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="SELECT DATE"
                android:backgroundTint="@color/darkNavy"
                android:textColor="@color/luxuryGold"
                android:textSize="13sp"
                android:letterSpacing="0.1"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="CONFIRM RESERVATION"
        android:backgroundTint="@color/luxuryGold"
        android:textColor="@color/darkNavy"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:layout_marginTop="8dp"/>

</LinearLayout>
