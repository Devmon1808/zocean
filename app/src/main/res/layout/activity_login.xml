<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background1"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <ImageView
        android:layout_width="176dp"
        android:layout_height="159dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/zhotel_logo_nobg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back"
        android:textColor="@color/softCream"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign in to continue"
        android:textColor="@color/softCream"
        android:alpha="0.7"
        android:textSize="14sp"
        android:layout_marginBottom="40dp"/>

    <EditText
        android:id="@+id/et_usernameInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Username"
        android:textColorHint="@color/softCream"
        android:textColor="@color/softCream"
        android:background="#1A0A1929"
        android:padding="16dp"
        android:inputType="text"
        android:layout_marginBottom="16dp"
        android:elevation="100dp"/>
    <EditText
        android:id="@+id/et_passwordInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Password"
        android:textColorHint="@color/softCream"
        android:textColor="@color/softCream"
        android:background="#1A0A1929"
        android:padding="16dp"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp"
        android:elevation="100dp"/>

    <Button
        android:id="@+id/b_loginButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SIGN IN"
        android:backgroundTint="@color/luxuryGold"
        android:textColor="@color/darkNavy"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.15" />

    <Button
        android:id="@+id/b_backButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="BACK"
        android:backgroundTint="@color/luxuryGold"
        android:textColor="@color/darkNavy"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"/>

</LinearLayout>