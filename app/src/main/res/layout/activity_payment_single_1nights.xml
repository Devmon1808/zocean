<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background1"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="85dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/zhotel_logo_nobg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment Summary"
        android:textColor="@color/softCream"
        android:textSize="16sp"
        android:alpha="0.8"
        android:layout_marginBottom="12dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#080918"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESERVATION DETAILS"
                android:textColor="@color/softCream"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Room Type"
                    android:textColor="@color/softCream"
                    android:alpha="0.7"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/roomTypeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OCEAN SINGLE"
                    android:textColor="@color/luxuryGold"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Duration"
                    android:textColor="@color/softCream"
                    android:alpha="0.7"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/nightsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 night(s)"
                    android:textColor="@color/softCream"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Price"
                    android:textColor="@color/softCream"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/totalPriceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱37,000"
                    android:textColor="@color/luxuryGold"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#080918"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAYMENT METHOD"
                android:textColor="@color/softCream"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <RadioGroup
                android:id="@+id/paymentMethodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/onlinePaymentRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Online Payment (Full Amount)"
                    android:textColor="@color/softCream"
                    android:textSize="15sp"
                    android:padding="12dp"
                    android:buttonTint="@color/luxuryGold"
                    android:checked="false"/>

                <RadioButton
                    android:id="@+id/cashPaymentRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cash Payment (50% Deposit)"
                    android:textColor="@color/softCream"
                    android:textSize="15sp"
                    android:padding="12dp"
                    android:buttonTint="@color/luxuryGold"
                    android:checked="false"/>
            </RadioGroup>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/confirmPaymentButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="CONFIRM PAYMENT"
        android:backgroundTint="@color/luxuryGold"
        android:textColor="@color/darkNavy"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"/>

</LinearLayout>