<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionBookings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background3"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-Add New Booking-"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/et_usernameInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Guest ID"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_inputBookingRoomId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Room ID"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_inputCheckIn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Check-in Date"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_inputCheckOut"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Check-out Date"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/et_inputTotalPrice"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Total Price"
        android:inputType="number"
        android:textColorHint="#B0BEC5"
        android:textColor="#FFFFFF"
        android:background="@color/darkBlue"
        android:padding="12dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/b_AddBooking"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ADD BOOKING"
        android:backgroundTint="@color/darkNavy"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-All Bookings-"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/bookingListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/darkBlue"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking #1"
                    android:textSize="14sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_guest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guest:"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tv_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room:"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5"/>

                <TextView
                    android:id="@+id/tv_checkIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check-in:"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_checkOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check-out:"
                    android:textSize="12sp"
                    android:textColor="#B0BEC5"/>

                <TextView
                    android:id="@+id/tv_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total:"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/b_edit"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/darkRed"
                        android:text="EDIT"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/b_delete"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="DELETE"
                        android:textSize="12sp"
                        android:backgroundTint="@color/darkRed"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
