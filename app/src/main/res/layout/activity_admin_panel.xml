<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/darkBlue"
        android:padding="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADMIN PANEL"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <Button
            android:id="@+id/btnAdminSignOut"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="-40dp"
            android:layout_marginEnd="16dp"
            android:text="SIGN OUT"
            android:textSize="10sp"
            android:textColor="@color/luxuryGold"
            android:backgroundTint="@android:color/transparent"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/darkBlue"
        android:padding="8dp">

        <Button
            android:id="@+id/tabGuests"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="GUESTS"
            android:textSize="12sp"
            android:backgroundTint="@color/darkRed"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/tabRooms"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="ROOMS"
            android:textSize="12sp"
            android:backgroundTint="@color/darkRed"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/tabBookings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="BOOKINGS"
            android:textSize="12sp"
            android:backgroundTint="@color/darkRed"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/guestsSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-Add New Guest-"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/inputGuestId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Guest ID"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/inputGuestName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Guest Name"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/inputGuestEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/inputGuestPhone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Phone Number"
                    android:inputType="phone"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnAddGuest"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ADD GUEST"
                    android:backgroundTint="@color/darkNavy"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-All Guests-"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/guestListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/roomsSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-Add New Room-"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/inputRoomId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Room ID"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/inputRoomType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Room Type"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/inputRoomPrice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Price"
                    android:inputType="number"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/inputRoomStatus"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Status"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/b_AddRoom"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ADD ROOM"
                    android:backgroundTint="@color/darkNavy"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-All Rooms-"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/roomListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/bookingsSection"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-Add New Booking-"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/et_usernameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Guest ID"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_inputBookingRoomId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Room ID"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_inputCheckIn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Check-in Date"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_inputCheckOut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Check-out Date"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_inputTotalPrice"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Total Price"
                    android:inputType="number"
                    android:textColorHint="#B0BEC5"
                    android:textColor="#FFFFFF"
                    android:background="@color/darkBlue"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/b_AddBooking"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ADD BOOKING"
                    android:backgroundTint="@color/darkNavy"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-All Bookings-"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/bookingListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</LinearLayout>